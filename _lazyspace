#compdef lazyspace

local -a cmds=(
  'add:register a repo'
  'forget:unregister a repo'
  'repos:list registered repos'
  'ls:list worktrees with status'
  'new:create a worktree and open it'
  'open:open a worktree session'
  'rm:remove a worktree'
  'run:(re)start the .lazyspace run command'
  'help:show help'
)
if (( CURRENT == 2 )); then
  _describe command cmds
  return
fi
case $words[2] in
  (open|rm|run) compadd -- ${(f)"$(lazyspace _names)"} ;;
  (forget) compadd -- ${${(f)"$(lazyspace repos)"}:t} ;;
  (add) _directories ;;
  (new) _arguments '-r[repo]:repo:(${${(f)"$(lazyspace repos)"}:t})' '-b[base ref]:ref:' '--no-open[do not open the session]' '1:branch:' ;;
esac
