#compdef lazyfleet

local -a cmds=(
  'add:register a repo'
  'forget:unregister a repo'
  'repos:list registered repos'
  'ls:list worktrees with status'
  'new:create a worktree and open it'
  'open:open a worktree session'
  'rm:remove a worktree'
  'pull:fast-forward a worktree to its upstream'
  'prune:remove worktrees whose branch is merged'
  'windows:switch between tmux windows'
  'config:edit settings, or a repo'"'"'s config file'
  'update:look for a newer release now'
  'status:tmux status segment for agents that need you'
  'hooks:install Claude Code hooks for agent state'
  'version:show the installed version'
  'help:show help'
)
if (( CURRENT == 2 )); then
  _describe command cmds
  return
fi
case $words[2] in
  (open|rm|pull) compadd -- ${(f)"$(lazyfleet _names)"} ;;
  (forget|config) compadd -- ${${(f)"$(lazyfleet repos)"}:t} ;;
  (add) _directories ;;
  (hooks) compadd install uninstall status ;;
  (status) compadd -- -p ;;
  (prune) _arguments '-n[only list what would be removed]' '-y[do not ask]' '--keep-branches[keep the local branches]' '--no-fetch[do not run git fetch --prune first]' '--all[all registered repos]' '-r[repo]:repo:(${${(f)"$(lazyfleet repos)"}:t})' ;;
  (new) _arguments '-r[repo]:repo:(${${(f)"$(lazyfleet repos)"}:t})' '-b[base ref]:ref:' '--no-open[do not open the session]' '1:branch:' ;;
esac
